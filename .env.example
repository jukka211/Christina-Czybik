# Copy to .env.local and fill in (see README.md). Set the same two
# NEXT_PUBLIC_ variables in the Vercel project's settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only for scripts/import-legacy.mjs (an Editor token, from
# sanity.io/manage or `npx sanity tokens add "Import" --role=editor`).
# Never needed on Vercel.
SANITY_API_WRITE_TOKEN=
